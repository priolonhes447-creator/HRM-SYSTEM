# ============================================================
# HRMS SUPABASE & PHP ENVIRONMENT CONFIGURATION
# ============================================================

# Supabase PostgreSQL Connection Credentials
DB_HOST=db.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=YOUR_SUPABASE_DB_PASSWORD

# Supabase API Settings (Optional if using PostgREST HTTP)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# JWT Authentication Secret Key
JWT_SECRET=hrms_php_supabase_secret_key_2026
JWT_EXPIRES_IN=86400

# Password recovery SMTP sender settings (server-side only)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=systemname@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=systemname@gmail.com
MAIL_FROM_NAME=HRMS
