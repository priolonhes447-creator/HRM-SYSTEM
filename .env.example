# ============================================================
# HRMS PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# HostForge PostgreSQL connection credentials (copy from cPanel)
APP_ENV=production
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USER
DB_PASS=YOUR_DATABASE_PASSWORD
DB_SSLMODE=prefer

# Supabase API Settings (Optional if using PostgREST HTTP)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# JWT Authentication Secret Key
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
JWT_EXPIRES_IN=86400

# Leave blank for same-origin requests. Otherwise use the exact HTTPS origin.
CORS_ALLOWED_ORIGIN=

# Password recovery SMTP sender settings (server-side only)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=systemname@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=systemname@gmail.com
MAIL_FROM_NAME=HRMS
