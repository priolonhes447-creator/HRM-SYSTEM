Options -Indexes

# Never serve configuration, source metadata, database exports, or deployment files.
<FilesMatch "(?i)(^\.|\.env$|\.sql$|\.db$|\.log$|\.md$|\.lock$|\.phar$|\.toml$|\.vbs$|package\.json$|composer\.json$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # These directories are not public web entry points.
    RewriteRule ^(?:backend|vendor|\.git|\.vscode)(?:/|$) - [F,L,NC]

    # Handle Authorization Header in XAMPP / FastCGI
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route every API path to the PHP PostgreSQL API, including nested paths.
    RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]
</IfModule>
