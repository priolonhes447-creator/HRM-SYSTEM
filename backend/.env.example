# ============================================================
# HRMS NODE.JS / EXPRESS BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port & Binding
PORT=5000
HOST=0.0.0.0

# JWT Authentication Secret Key & Expiry
JWT_SECRET=hrms_pro_secret_key_2026
JWT_EXPIRES_IN=24h

# PostgreSQL used by the PHP API when the site is served by Apache/XAMPP
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hrms_db
DB_USER=postgres
DB_PASS=your_postgresql_password
DB_SSLMODE=prefer

# Server-side SMTP settings for password recovery
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=systemname@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=systemname@gmail.com
MAIL_FROM_NAME=HRMS
